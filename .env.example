# Environment: local | staging | production
NEXT_PUBLIC_SITE_ENV=staging
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only enable after moving to promsafe.ru and approving public indexing.
SITE_INDEXING_APPROVED=false

# External writes are OFF by default. Turn on only after CRM is configured and tested.
EXTERNAL_WRITES_ENABLED=false

# Bitrix24 example:
# https://YOUR_PORTAL.bitrix24.ru/rest/USER_ID/WEBHOOK_KEY/crm.lead.add.json
CRM_WEBHOOK_URL=

# Analytics stays off until consent management and Yandex Metrica are configured.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Activate the form only after an approved privacy policy, consent text and CRM acceptance tests.
NEXT_PUBLIC_LEAD_FORM_ENABLED=false
NEXT_PUBLIC_LEAD_BACKEND_READY=false
NEXT_PUBLIC_PRIVACY_POLICY_URL=
